{
  "name": "clash-tournament",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/bootstrap/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "secret:scan": "grep -RInE \"(DISCORD_TOKEN|CLASH_API_TOKEN|AKIA|AIza|-----BEGIN PRIVATE KEY-----|Authorization:|Bearer )\" src tests .github README.md .env.example . --exclude-dir=node_modules --exclude-dir=.git || true"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.3"
  }
}
